<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Proyecto Integradora Interactivo</title>
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      text-align: center;
      padding: 40px;
      background-size: 600% 600%;
      animation: fondoGradual 20s ease infinite;
      transition: background-color 1s;
    }

    @keyframes fondoGradual {
      0% {background-position: 0% 50%;}
      50% {background-position: 100% 50%;}
      100% {background-position: 0% 50%;}
    }

    h1 {
      font-size: 2.5em;
      animation: moverTitulo 3s infinite alternate;
    }

    @keyframes moverTitulo {
      0% { transform: translateX(-10px); }
      100% { transform: translateX(10px); }
    }

    .explicacion {
      font-size: 1.2em;
      margin: 20px auto;
      max-width: 800px;
      color: #333;
      background-color: #fff8f9;
      padding: 20px;
      border-radius: 10px;
    }

    .boton, .link {
      display: inline-block;
      margin: 20px 10px;
      padding: 12px 25px;
      background-color: #6c63ff;
      color: white;
      text-decoration: none;
      border-radius: 10px;
      font-weight: bold;
      transition: background-color 0.3s, transform 0.3s;
      cursor: pointer;
    }

    .boton:hover, .link:hover {
      background-color: #483d8b;
      transform: scale(1.05);
    }

    .seccion {
      display: none;
    }

    .activa {
      display: block;
    }

    iframe {
      border: 3px solid #3498db;
      border-radius: 10px;
      margin-top: 20px;
    }

    .links a {
      display: inline-block;
      margin: 10px;
      padding: 12px 25px;
      background-color: #6c63ff;
      color: white;
      text-decoration: none;
      border-radius: 30px;
      transition: all 0.3s ease;
      font-size: 16px;
    }

    .links a:hover {
      background-color: #483d8b;
      transform: scale(1.08);
    }

    .letter {
      background-color: #fffaf0;
      border: 2px solid #d8bfd8;
      border-radius: 10px;
      padding: 20px;
      margin: 20px auto;
      width: 80%;
      box-shadow: 2px 2px 10px #ccc;
    }

    .label {
      font-weight: bold;
      color: #2f4f4f;
      margin-bottom: 10px;
    }

    .marquee {
      background-color: #d8bfd8;
      padding: 10px;
      font-size: 24px;
      color: white;
      font-weight: bold;
      border-radius: 10px;
      margin-bottom: 30px;
    }

    /* Estilos para la sección del currículum */
    .resume-container {
      width: 70%;
      margin: 20px auto;
      background-color: white;
      padding: 20px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      border-radius: 10px;
      text-align: left;
    }

    .resume-header {
      display: flex;
      align-items: center;
      background-color: #e0eafc;
      padding: 20px;
      border-radius: 10px;
      margin-bottom: 20px;
    }

    .resume-header img {
      border-radius: 50%;
      width: 100px;
      height: 100px;
      margin-right: 20px;
    }

    .resume-header h1 {
      margin: 0;
      color: #2c3e50;
    }

    .resume-header p {
      margin: 5px 0 0;
      color: #7f8c8d;
    }

    .resume-section {
      margin: 20px 0;
    }

    .resume-section h2 {
      border-bottom: 2px solid #e0eafc;
      padding-bottom: 5px;
      color: #3498db;
    }

    .resume-section ul {
      list-style: none;
      padding: 0;
    }

    .resume-section ul li {
      margin-bottom: 10px;
      padding-left: 20px;
      position: relative;
    }

    .resume-section ul li:before {
      content: "•";
      color: #6c63ff;
      font-size: 20px;
      position: absolute;
      left: 0;
      top: -2px;
    }

    .resume-link {
      color: #6c63ff;
      text-decoration: none;
    }

    .resume-link:hover {
      text-decoration: underline;
    }
  </style>
</head>
